# Clearance environment. Copy to .env (gitignored). Placeholders only in this file.

# ── Provider keys (agents) ─────────────────────────────────────────────────────
# Claude agents. Leave blank to use your Claude Code login on the host.
ANTHROPIC_API_KEY=
# Codex agent, and OpenCode's provider when OPENCODE_PROVIDER_KEY is blank.
OPENAI_API_KEY=
# OpenCode provider key. Blank means reuse OPENAI_API_KEY.
OPENCODE_PROVIDER_KEY=

# ── Switch (values come from vendor/switch/.env, generated by `just init-env`) ─
SWITCH_BRIDGE_URL=http://127.0.0.1:8000
SWITCH_GATEWAY_URL=http://127.0.0.1:3000
MATTERMOST_URL=http://127.0.0.1:8065

# ── Clearance services ─────────────────────────────────────────────────────────
CLEARANCE_CORE_PORT=7700
CLEARANCE_GATE_PORT=7710
ACME_PORT=7800
CLEARANCE_DESK_PORT=7900
CLEARANCE_TIME_SCALE=1
CLEARANCE_DB_PATH=./data/clearance.sqlite
# Shared secret between agent hooks and clearance-core. Generate with: openssl rand -hex 24
CLEARANCE_HOOK_TOKEN=change-me
# Core to gate calls (execute, lookup). Generate with: openssl rand -hex 24
CLEARANCE_INTERNAL_TOKEN=change-me
# Custody credential: only clearance-gate reads this. Generate with: openssl rand -hex 24
ACME_ADMIN_KEY=change-me
# Fine-grained GitHub token for acme-mini-app, gate only. Optional for the demo.
GITHUB_GATE_TOKEN=

# ── Budget ─────────────────────────────────────────────────────────────────────
CLEARANCE_EVAL_SPEND_CAP_USD=35
