{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7790/hook/deny-push",
            "timeout": 20,
            "onFailure": "block",
            "headers": { "Authorization": "Bearer $CLEARANCE_HOOK_TOKEN" },
            "allowedEnvVars": ["CLEARANCE_HOOK_TOKEN"]
          }
        ]
      }
    ]
  }
}
