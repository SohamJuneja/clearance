{
  "name": "hackathon-video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "draft": "remotion render src/index.ts Film out/draft.mp4 --scale=0.5 --crf=26 --pixel-format=yuv420p --color-space=bt709",
    "render": "remotion render src/index.ts Film out/film.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac",
    "typecheck": "tsc --noEmit",
    "scene": "remotion render src/index.ts Film --pixel-format=yuv420p --color-space=bt709 --crf=16",
    "thumb": "remotion still src/index.ts Thumbnail out/thumbnail.png"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@remotion/captions": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/gif": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "@remotion/lottie": "4.0.541",
    "@remotion/media": "4.0.541",
    "@remotion/three": "4.0.541",
    "@remotion/transitions": "4.0.541",
    "lottie-web": "5.13.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/three": "0.187.0",
    "typescript": "5.9.3"
  }
