      "file": "packages/core/src/router/router.ts",
      "lang": "ts",
      "code": "function exclusionsFor(ctx: RouteContext, id: string): Exclusion[] {\n  const reasons: Exclusion[] = [];\n  if (ctx.policy.defaults.exclude_requester\n      && ctx.requesterIds.includes(id)) reasons.push(\"requester\");\n  if (ownerExcluded(ctx)\n      && ctx.agentOwnerIds.includes(id)) reasons.push(\"agent_owner\");\n  if (ctx.authorIds.includes(id)) reasons.push(\"author\");\n  if (ctx.signals.away(id)) reasons.push(\"away\");\n  if (ctx.counted.includes(id)) reasons.push(\"counted\");\n  if (ctx.failedConfirm?.includes(id)) reasons.push(\"failed_confirm\");\n  return reasons;\n}",
