diff --git a/core/switch_core/connections/catalog/canva/connection.yaml b/core/switch_core/connections/catalog/canva/connection.yaml
index 6e538344..c1fc6480 100644
--- a/core/switch_core/connections/catalog/canva/connection.yaml
+++ b/core/switch_core/connections/catalog/canva/connection.yaml
@@ -1,7 +1,54 @@
 slug: canva
 name: Canva
 category: Design
-description: Create and export Canva designs.
-enabled: false
+description: Search, read and edit Canva designs, as you.
+enabled: true
+adapter: oauth
 auth:
   type: oauth
+  # TO MEASURE: whether a refresh returns a new refresh token and ends the last
+  # one. Taken from Canva's documentation; no sign-in has shown it here.
+  refresh: rotating
+  oauth:
+    # Canva's authorization server offers no registration endpoint, so each
+    # server's operator creates an app in Canva's Developer Portal, turns on
+    # Canva MCP, and names it in CANVA_CLIENT_CONFIG_PATH.
+    registration: static
+    client_settings: CANVA
+    # Canva matches a redirect exactly, port included, so the app lists each of
+    # these.
+    redirect: [loopback]
+    loopback_ports: [39231, 39232, 39233, 39234, 39235]
+    unchecked: >-
+      Switch can't check the app's redirect URLs, or that Canva MCP is turned on
+      for it. Connect once to confirm.
+    # TO MEASURE: that this cuts access. Canva's metadata advertises no
+    # revocation endpoint, so this address is from Canva's documentation. If it
+    # doesn't, replace it with remove_access, saying where people remove Switch.
+    revocation_url: https://api.canva.com/rest/v1/oauth/revoke
+  identity:
+    # TO MEASURE: that this accepts a token from the MCP sign-in, and that
+    # team_user.user_id is the stable id. No profile:read just for a display name.
+    url: https://api.canva.com/rest/v1/users/me
+    account_id: team_user.user_id
+    label: team_user.user_id
+# TO MEASURE: expires_in on a real sign-in. 14400 is Canva's documented lifetime.
+token: { kind: pass_through, max_lifetime: 14400 }
+mcp:
+  servers:
+    - { name: canva, url: "https://api.canva.com/connect/v1/mcp" }
+access:
+  # The server lists more than this. Not asked for: folder:write,
+  # brandtemplate:content:write, comment:write, asset:write and help:answers:write.
+  # TO MEASURE: that these are enough for the tools it lists, and that Canva
+  # refuses a write from a read-only sign-in. If it doesn't, offer one level.
+  read:
+    scopes:
+      - design:meta:read
+      - design:content:read
+  write:
+    scopes:
+      - design:meta:read
+      - design:content:read
+      - design:content:write
+tools: { mode: pass_through }
