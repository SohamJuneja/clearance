+    assert oauth.client_settings == "CANVA"
+    assert oauth.loopback_ports == [39231, 39232, 39233, 39234, 39235]
+    assert oauth.unchecked is not None and "Canva MCP" in oauth.unchecked
+    assert definition.auth.identity is not None
+    assert definition.auth.identity.account_id == "team_user.user_id"
+    assert definition.mcp is not None
+    assert [(s.name, s.url) for s in definition.mcp.servers] == [
+        ("canva", "https://api.canva.com/connect/v1/mcp")
+    ]
+    assert definition.access is not None and definition.access.write is not None
+    read = ["design:meta:read", "design:content:read"]
+    assert definition.access.read.scopes == read
+    assert definition.access.write.scopes == [*read, "design:content:write"]
+    assert definition.tools.mode == "pass_through"
+    # TO MEASURE: these three are Canva's documentation until a real sign-in
