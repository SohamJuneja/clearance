{
  "disableClaudeAiConnectors": true,
  "permissions": { "deny": ["mcp__claude_ai_*"] },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?!mcp__switch__(connect_to_room|list_rooms|read_context|list_participants|post_message|send_targeted_message)$|ToolSearch$).*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:7700/v1/hooks/claude",
            "timeout": 20,
            "onFailure": "block",
            "headers": { "Authorization": "Bearer $CLEARANCE_HOOK_TOKEN" },
            "allowedEnvVars": ["CLEARANCE_HOOK_TOKEN"]
          }
        ]
      }
    ]
  }
}
