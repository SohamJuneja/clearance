# Clearance environment. Copy to .env (gitignored). Placeholders only in this file.

# ── Provider keys (agents) ─────────────────────────────────────────────────────
# Claude agents need this, or a Claude login on this host. Claude agents can read this key from inside their fence.
# With a login instead, they get a copy of its short-lived access token and never the refresh token.
ANTHROPIC_API_KEY=
# Codex agent, and OpenCode's provider when OPENCODE_PROVIDER_KEY is blank.
OPENAI_API_KEY=
# OpenCode provider key. Blank means reuse OPENAI_API_KEY.
OPENCODE_PROVIDER_KEY=

# ── Switch (values come from vendor/switch/.env, generated by `just init-env`) ─
SWITCH_BRIDGE_URL=http://127.0.0.1:8000
SWITCH_GATEWAY_URL=http://127.0.0.1:3000
MATTERMOST_URL=http://127.0.0.1:8065

# Mattermost and Switch password of the demo personas (scripts/setup-identities.ts). Demo-only: the
# stack binds to 127.0.0.1, so this value only ever works on a localhost stack. Never reuse it.
PERSONA_PASSWORD=clearance-demo-localhost-only
# Where setup-identities.ts writes identities.json and secrets.json. Defaults to ./data.
CLEARANCE_DATA_DIR=./data
# Switch's generated env file, read (never printed) by setup-identities.ts. Defaults to vendor/switch/.env.
SWITCH_ENV_FILE=./vendor/switch/.env

# ── Clearance services─────────────────────────────────────────────────────────
CLEARANCE_CORE_PORT=7700
CLEARANCE_GATE_PORT=7710
ACME_PORT=7800
CLEARANCE_DESK_PORT=7900
# The Desk answers on loopback only. Name a host here to expose it, since it has no login.
# DESK_ALLOWED_HOSTS=
CLEARANCE_TIME_SCALE=1
# How often a real hold also sends a practice request, from 0 to 1. 0 here so a demo or eval take can't get a
# surprise card. Delete this line and the policy's rate applies. POST /v1/drills/send works whatever it says.
CLEARANCE_DRILL_RATE=0
CLEARANCE_DB_PATH=./data/clearance.sqlite
# CLEARANCE_POLICY_PATH=policy/clearance.policy.yaml
# CLEARANCE_TEAM_PATH=policy/team.yaml
# Per-agent hook tokens, token to agent name. Not set by hand: scripts/setup-agents.ts writes the file and
# core refuses to start without it. There is no shared hook token any more. Defaults to data/hook-tokens.json.
# CLEARANCE_HOOK_TOKENS_PATH=./data/hook-tokens.json
# Core and gate calling each other (check, execute, lookup). Agents never see it, unlike the hook
# token. Generate with: openssl rand -hex 24
CLEARANCE_INTERNAL_TOKEN=change-me
# Optional, off when unset. Turns on POST /guardrails/check, the advisory check Switch's Trust setting calls, on a
# listener of its own. This is the key you give Switch. See "Switch Trust" in the README. Generate with: openssl rand -hex 24
# CLEARANCE_TRUST_KEY=
# Switch runs in Docker, so use the address of its Docker network's gateway. Defaults: 127.0.0.1 and 7701.
# CLEARANCE_TRUST_HOST=
# CLEARANCE_TRUST_PORT=
# Custody credential: only clearance-gate reads this. Generate with: openssl rand -hex 24
ACME_ADMIN_KEY=change-me
# Fine-grained GitHub token for acme-mini-app, gate only. Optional for the demo.
GITHUB_GATE_TOKEN=

# ── Acme Mini (synthetic data) ─────────────────────────────────────────────────
ACME_URL=http://127.0.0.1:7800
ACME_DB_PATH=./data/acme.sqlite
# Only the container sets this. Acme binds to 127.0.0.1 without it.
# ACME_HOST=0.0.0.0
# The acme CLI talks to the gate with one agent's gate token, never with ACME_ADMIN_KEY.
ACME_GATE_URL=http://127.0.0.1:7710
ACME_GATE_TOKEN=change-me

# ── In-Switch study (scripts/setup-study-accounts.ts, study/bot) ────────────────
# STUDY_DRY_RUN and STUDY_RESULTS_DIR below apply to it too. Run only some participants, for example:
# STUDY_PARTICIPANTS=p01,p02
# Where scripts/study-expose.sh finds the Switch checkout. Defaults to vendor/switch.
# SWITCH_DIR=./vendor/switch

# ── Approval Lab (user study, study/app) ───────────────────────────────────────
STUDY_PORT=7950
# Signs participant links. Generate with: openssl rand -hex 24
STUDY_LINK_SECRET=change-me
# Set to 1 to rehearse: every event is marked synthetic, and STUDY_RESULTS_DIR must be set elsewhere.
# STUDY_DRY_RUN=1
# STUDY_RESULTS_DIR=/tmp/lab-rehearsal

# ── Gate and hooks ─────────────────────────────────────────────────────────────
# Per-agent gate tokens, JSON of token to {agent, classes}. Classes: refund, deploy,
# customer_email, payout_change, delete, merge. Generate each token with: openssl rand -hex 24
# GATE_AGENT_TOKENS='{"<token>":{"agent":"refunds-agent","classes":["refund","customer_email"]}}'
GATE_AGENT_TOKENS=
CLEARANCE_GATE_HOST=127.0.0.1
CLEARANCE_GATE_DB_PATH=./data/gate.sqlite
CLEARANCE_CORE_URL=http://127.0.0.1:7700
CLEARANCE_GATE_URL=http://127.0.0.1:7710
# Client timeout for clearance-hook. Stay under the 2 s wrapper in .codex/hooks.json.
CLEARANCE_HOOK_TIMEOUT_MS=1500
# Overrides the CLI path setup-agent records in .clearance/hook-cli. For running by hand: this env
# does not reach hook commands under Switch.
CLEARANCE_HOOK_CLI=

# ── Budget ─────────────────────────────────────────────────────────────────────
CLEARANCE_EVAL_SPEND_CAP_USD=35
# Where each E2 agent pushes, to see whether its `main` moved. scripts/setup-e2.ts sets these.
# CLEARANCE_E2_REMOTE_REFUNDS_AGENT=/path/to/.origin/acme-mini-app.git

# ── Eval and video ─────────────────────────────────────────────────────────────
CLEARANCE_E4_GATE_TOKEN=
CLEARANCE_E4_AGENT_CWD=
CLEARANCE_CORE_STOP_CMD=
CLEARANCE_CORE_START_CMD=
CLEARANCE_REPO_URL=
# Optional overrides
# CLEARANCE_CHROMIUM=/snap/bin/chromium
# CLEARANCE_PIPER_BIN=
# CLEARANCE_PIPER_MODEL=

# ── Core: inbox, ledger mirror, @clearance install ──────────────────────────────
# Shown in the reply to `@clearance ledger`, as the base of the room's page. Off the Gateway's own port by default.
# CLEARANCE_GATEWAY_URL=http://127.0.0.1:3000
# Only to run a second core beside the real one: its own agent, and its own install under other names.
# CLEARANCE_AGENT_NAME=clearance
# CLEARANCE_TEMPLATE_PATH=templates/clearance.template.yaml
# CLEARANCE_TEMPLATE_NAME=clearance-install
# CLEARANCE_INSTALL_ROOM=approvals
