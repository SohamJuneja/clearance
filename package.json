{
  "name": "clearance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "mkdir -p .tmp && export TMPDIR=\"$PWD/.tmp\" && pnpm -r --parallel --workspace-concurrency=4 test && vitest run study/ && pnpm test:proof",
    "test:proof": "vitest run --config eval/vitest.config.ts",
    "typecheck": "pnpm -r --workspace-concurrency=4 typecheck && tsc --noEmit -p study/tsconfig.json && tsc --noEmit -p eval/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "policy:test": "pnpm --filter @clearance/core exec vitest run test/policy-table.test.ts",
    "ledger:verify": "tsx packages/core/src/cli/ledger-verify.ts",
    "acme:start": "pnpm --filter @clearance/acme start",
    "desk:build": "pnpm --filter @clearance/desk build",
    "desk:start": "pnpm --filter @clearance/desk start",
    "desk:fixture": "DESK_FIXTURE=1 pnpm --filter @clearance/desk start",
    "desk:e2e": "pnpm --filter @clearance/desk e2e",
    "study:sets": "tsx study/tools/build-sets.ts",
    "study:golden": "bash study/tools/regen-golden.sh",
    "study:start": "tsx study/app/server.ts",
    "study:links": "tsx study/app/links.ts",
    "study:accounts": "tsx scripts/setup-study-accounts.ts",
    "study:bot": "tsx study/bot/main.ts",
    "study:expose": "bash scripts/study-expose.sh",
    "study:rehearse": "tsx study/tools/rehearsal.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo:run": "tsx scripts/demo-run.ts",
    "video:build": "tsx scripts/video/build.ts",
    "video:smoke": "tsx scripts/video/smoke.ts",
    "video:desk": "tsx scripts/video/desk-shots.ts",
    "eval:authority": "tsx eval/authority-suite/run.ts",
    "eval:mutations": "tsx eval/authority-suite/mutations/run.ts",
    "eval:baseline": "tsx eval/baseline/run.ts",
    "eval:behaviour": "tsx eval/behaviour/run.ts",
    "eval:vendors": "tsx eval/cross-vendor/run.ts",
    "eval:classifier": "tsx eval/classifier/run.ts",
    "eval:classifier:sample": "tsx eval/classifier/sample.ts",
    "eval:latency": "tsx eval/latency-soak/latency.ts",
    "eval:soak": "tsx eval/latency-soak/soak.ts",
    "eval:study": "tsx eval/study/run.ts",
    "eval:autonomy": "tsx eval/autonomy/run.ts",
    "eval:report": "tsx eval/report.ts",
    "eval:all": "tsx eval/all.ts",
    "seed:history": "tsx scripts/seed-history.ts",
    "core:start": "tsx --env-file=.env packages/core/src/main.ts",
    "gate:start": "tsx --env-file=.env packages/gate/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.15.0",
    "playwright-core": "1.58.2",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^3.2.0",
    "yaml": "^2.6.0",
    "zod": "^3.25.0"
  }
}
